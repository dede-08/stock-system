{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Se sobrescribe con env var ConnectionStrings__DefaultConnection (ver .env.example).
    // No poner credenciales reales aquí.
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "api-gestion-productos",
    "Audience": "shopstore-app",
    "ExpiryMinutes": 120,
    "RefreshExpiryDays": 7
  },
  "Admin": {
    // Se sobrescribe con env var Admin__Email. Ese usuario queda como ADMIN al arrancar.
    "Email": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
