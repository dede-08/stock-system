# Copia a .env (NO commitear, ya ignorado por .gitignore)
# Genera una clave de 64+ bytes: openssl rand -base64 64

# JWT (mínimo 32 caracteres, recomendado 64+)
JWT_KEY=REEMPLAZA_POR_CLAVE_GENERADA_MIN_64_CHARS_AQUI
JWT_ISSUER=api-gestion-productos
JWT_AUDIENCE=shopstore-app
JWT_EXPIRY_MINUTES=120
JWT_REFRESH_DAYS=7

# Bootstrap del primer admin (env Admin__Email). Regístrate primero, luego reinicia.
ADMIN_EMAIL=tu-email@admin.com

# Postgres — usa UNA de las dos formas:
# Opción A (recomendada): variable estándar que mapea a ConnectionStrings__DefaultConnection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=products_database;Username=postgres;Password=REEMPLAZA_PASSWORD
# Opción B: partes separadas (si prefieres armar el string en código / docker)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=products_database
# PGUSER=postgres
# PGPASSWORD=REEMPLAZA_PASSWORD

# CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Solo compose.yaml (raíz) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=products_database
PGUSER=postgres
PGPASSWORD=REEMPLAZA_PASSWORD
FRONTEND_URL=http://localhost:4200
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
